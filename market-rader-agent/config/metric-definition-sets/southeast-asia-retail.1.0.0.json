      "value_type": "ordinal", "raw_unit": "level", "direction": "higher_better", "indicator_weight_bps": 2000,
      "aggregation_method": "ordinal_from_evidence", "aggregation_config": { "predicate": "partner_channel_availability_level" },
      "normalization_method": "ordinal_rubric",
      "normalization_config": { "levels": ["none", "limited", "strong"], "scores_bps": [1000, 5000, 10000] },
      "freshness_window_days": 1095, "input_predicates": ["partner_channel_availability_level"]
    },
    {
      "metric_code": "competition_intensity", "dimension_code": "entry_ease", "name": "Competition Intensity",
      "value_type": "decimal", "raw_unit": "index", "direction": "lower_better", "indicator_weight_bps": 1500,
      "aggregation_method": "competition_from_market_structure", "aggregation_config": { "input_predicates": ["competition_intensity_index", "qualified_retailer_count_actual", "top_customer_concentration_percent"], "derivation_version": "derived-retail-v1" },
