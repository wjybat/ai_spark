      "freshness_window_days": 1095, "critical": true, "input_predicates": ["privacy_video_regulation_fit_level"]
    },
    {
      "metric_code": "deployment_data_residency_fit", "dimension_code": "entry_ease", "name": "Deployment Data Residency Fit",
      "value_type": "ordinal", "raw_unit": "level", "direction": "higher_better", "indicator_weight_bps": 2000,
