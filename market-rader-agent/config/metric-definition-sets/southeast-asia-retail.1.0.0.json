{
  "code": "southeast_asia_retail",
  "version": "1.0.0",
  "status": "draft",
  "metrics": [
    {
      "metric_code": "qualified_store_base", "dimension_code": "market_size", "name": "Qualified Store Base",
      "value_type": "integer", "raw_unit": "store", "direction": "higher_better", "indicator_weight_bps": 5000,
      "aggregation_method": "qualified_store_base_from_retailers", "aggregation_config": { "input_predicates": ["qualified_store_base_actual", "retailer_store_count_actual"], "derivation_version": "retailer-foundations-v1", "minimum_store_count": 500, "minimum_retailers": 3 },
      "normalization_method": "piecewise_linear",
      "normalization_config": { "anchors": [ { "raw": "2000", "score_bps": 0 }, { "raw": "10000", "score_bps": 3000 }, { "raw": "30000", "score_bps": 6000 }, { "raw": "60000", "score_bps": 8500 }, { "raw": "120000", "score_bps": 10000 } ] },
      "freshness_window_days": 1095, "input_predicates": ["qualified_store_base_actual", "retailer_store_count_actual"]
    },
    {
      "metric_code": "qualified_retailer_count", "dimension_code": "market_size", "name": "Qualified Retailer Count",
      "value_type": "integer", "raw_unit": "retailer", "direction": "higher_better", "indicator_weight_bps": 3000,
      "aggregation_method": "qualified_retailer_count_from_observed_retailers", "aggregation_config": { "input_predicates": ["qualified_retailer_count_actual", "retailer_store_count_actual"], "derivation_version": "retailer-foundations-v1", "minimum_store_count": 500, "minimum_retailers": 3 },
      "normalization_method": "piecewise_linear",
      "normalization_config": { "anchors": [ { "raw": "5", "score_bps": 0 }, { "raw": "15", "score_bps": 3000 }, { "raw": "30", "score_bps": 6000 }, { "raw": "50", "score_bps": 8500 }, { "raw": "100", "score_bps": 10000 } ] },
      "freshness_window_days": 1095, "input_predicates": ["qualified_retailer_count_actual", "retailer_store_count_actual"]
    },
    {
      "metric_code": "modern_retail_scale", "dimension_code": "market_size", "name": "Modern Retail Scale",
      "value_type": "percent", "raw_unit": "percent", "direction": "higher_better", "indicator_weight_bps": 2000,
      "aggregation_method": "latest_value", "aggregation_config": { "predicate": "modern_retail_share_percent" },
      "normalization_method": "piecewise_linear",
      "normalization_config": { "anchors": [ { "raw": "10", "score_bps": 0 }, { "raw": "30", "score_bps": 3000 }, { "raw": "50", "score_bps": 6000 }, { "raw": "70", "score_bps": 8500 }, { "raw": "90", "score_bps": 10000 } ] },
      "freshness_window_days": 1095, "input_predicates": ["modern_retail_share_percent"]
    },
    {
      "metric_code": "format_store_cagr_3y", "dimension_code": "growth", "name": "Format Store CAGR 3Y",
      "value_type": "percent", "raw_unit": "percent", "direction": "higher_better", "indicator_weight_bps": 4500,
      "aggregation_method": "portfolio_cagr_from_retailer_observations", "aggregation_config": { "input_predicates": ["format_store_count_actual", "retailer_store_count_actual"], "derivation_version": "retailer-foundations-v1", "minimum_store_count": 500, "minimum_retailers": 3, "minimum_years": 2.5, "maximum_years": 3.5 },
      "normalization_method": "piecewise_linear",
      "normalization_config": { "anchors": [ { "raw": "-5", "score_bps": 0 }, { "raw": "0", "score_bps": 2000 }, { "raw": "5", "score_bps": 5000 }, { "raw": "10", "score_bps": 7500 }, { "raw": "20", "score_bps": 10000 } ] },
      "freshness_window_days": 1095, "minimum_verified_claims": 2, "input_predicates": ["format_store_count_actual", "retailer_store_count_actual"]
    },
    {
      "metric_code": "modern_retail_sales_cagr_3y", "dimension_code": "growth", "name": "Modern Retail Sales CAGR 3Y",
      "value_type": "percent", "raw_unit": "percent", "direction": "higher_better", "indicator_weight_bps": 3500,
      "aggregation_method": "latest_value", "aggregation_config": { "predicate": "modern_retail_sales_cagr_percent" },
      "normalization_method": "piecewise_linear",
      "normalization_config": { "anchors": [ { "raw": "0", "score_bps": 0 }, { "raw": "5", "score_bps": 3000 }, { "raw": "10", "score_bps": 6500 }, { "raw": "15", "score_bps": 10000 } ] },
      "freshness_window_days": 730, "input_predicates": ["modern_retail_sales_cagr_percent"]
    },
    {
      "metric_code": "qualified_retailer_store_growth", "dimension_code": "growth", "name": "Qualified Retailer Store Growth",
      "value_type": "percent", "raw_unit": "percent", "direction": "higher_better", "indicator_weight_bps": 2000,
      "aggregation_method": "retailer_growth_from_store_counts", "aggregation_config": { "input_predicates": ["retailer_store_growth_percent", "retailer_store_count_actual"], "derivation_version": "retailer-foundations-v1", "minimum_store_count": 500, "minimum_retailers": 3, "minimum_years": 0.75, "maximum_years": 1.5 },
      "normalization_method": "piecewise_linear",
      "normalization_config": { "anchors": [ { "raw": "0", "score_bps": 0 }, { "raw": "3", "score_bps": 2500 }, { "raw": "6", "score_bps": 5000 }, { "raw": "10", "score_bps": 8000 }, { "raw": "15", "score_bps": 10000 } ] },
      "freshness_window_days": 730, "input_predicates": ["retailer_store_growth_percent", "retailer_store_count_actual"]
    },
    {
      "metric_code": "announced_openings_ratio", "dimension_code": "expansion", "name": "Announced Openings Ratio",
      "value_type": "percent", "raw_unit": "percent", "direction": "higher_better", "indicator_weight_bps": 4500,
      "aggregation_method": "ratio_from_observations", "aggregation_config": { "numerator_predicate": "announced_store_openings_actual", "denominator_predicate": "format_store_count_actual", "annualized": true },
      "normalization_method": "piecewise_linear",
      "normalization_config": { "anchors": [ { "raw": "0", "score_bps": 0 }, { "raw": "2", "score_bps": 3000 }, { "raw": "5", "score_bps": 6000 }, { "raw": "8", "score_bps": 8500 }, { "raw": "12", "score_bps": 10000 } ] },
      "freshness_window_days": 548, "input_predicates": ["announced_store_openings_actual", "format_store_count_actual"]
    },
    {
      "metric_code": "expanding_retailer_share", "dimension_code": "expansion", "name": "Expanding Retailer Share",
      "value_type": "percent", "raw_unit": "percent", "direction": "higher_better", "indicator_weight_bps": 3000,
      "aggregation_method": "expanding_share_from_origins", "aggregation_config": { "input_predicates": ["expanding_retailer_share_percent", "announced_store_openings_actual", "qualified_retailer_count_actual"], "derivation_version": "derived-retail-v1", "method": "distinct_positive_opening_origins_divided_by_qualified_retailers" },
      "normalization_method": "piecewise_linear",
      "normalization_config": { "anchors": [ { "raw": "0", "score_bps": 0 }, { "raw": "20", "score_bps": 3000 }, { "raw": "40", "score_bps": 6000 }, { "raw": "60", "score_bps": 8500 }, { "raw": "80", "score_bps": 10000 } ] },
      "freshness_window_days": 548, "input_predicates": ["expanding_retailer_share_percent", "announced_store_openings_actual", "qualified_retailer_count_actual"]
    },
    {
