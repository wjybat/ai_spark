      "normalization_config": { "anchors": [ { "raw": "1", "score_bps": 10000 }, { "raw": "3", "score_bps": 7500 }, { "raw": "5", "score_bps": 5000 }, { "raw": "7", "score_bps": 2500 }, { "raw": "10", "score_bps": 0 } ] },
      "freshness_window_days": 1095, "input_predicates": ["competition_intensity_index", "qualified_retailer_count_actual", "top_customer_concentration_percent"]
    },
    {
      "metric_code": "localization_sales_friction", "dimension_code": "entry_ease", "name": "Localization / Sales Friction",
      "value_type": "decimal", "raw_unit": "index", "direction": "lower_better", "indicator_weight_bps": 2000,
      "aggregation_method": "localization_friction_from_partner", "aggregation_config": { "input_predicates": ["localization_sales_friction_index", "partner_channel_availability_level"], "derivation_version": "derived-retail-v1", "partner_level_to_index": { "none": 5, "limited": 3, "strong": 1 } },
      "normalization_method": "piecewise_linear",
      "normalization_config": { "anchors": [ { "raw": "1", "score_bps": 10000 }, { "raw": "2", "score_bps": 7500 }, { "raw": "3", "score_bps": 5000 }, { "raw": "4", "score_bps": 2500 }, { "raw": "5", "score_bps": 0 } ] },
      "freshness_window_days": 1095, "input_predicates": ["localization_sales_friction_index"]
