    {
      "metric_code": "video_infrastructure_readiness", "dimension_code": "digital", "name": "Video Infrastructure Readiness",
      "value_type": "ordinal", "raw_unit": "level", "direction": "higher_better", "indicator_weight_bps": 2500,
      "aggregation_method": "ordinal_from_evidence", "aggregation_config": { "predicate": "video_infrastructure_readiness_level" },
      "normalization_method": "ordinal_rubric",
      "normalization_config": { "levels": ["low", "medium", "high"], "scores_bps": [2000, 6000, 10000] },
      "freshness_window_days": 1095, "input_predicates": ["video_infrastructure_readiness_level"]
    },
    {
      "metric_code": "cloud_connectivity_readiness", "dimension_code": "digital", "name": "Cloud Connectivity Readiness",
      "value_type": "ordinal", "raw_unit": "level", "direction": "higher_better", "indicator_weight_bps": 2500,
      "aggregation_method": "ordinal_from_evidence", "aggregation_config": { "predicate": "cloud_connectivity_readiness_level" },
      "normalization_method": "ordinal_rubric",
      "normalization_config": { "levels": ["low", "medium", "high"], "scores_bps": [2000, 6000, 10000] },
      "freshness_window_days": 1095, "input_predicates": ["cloud_connectivity_readiness_level"]
    },
    {
      "metric_code": "retailer_digital_investment_signals", "dimension_code": "digital", "name": "Retailer Digital Investment Signals",
      "value_type": "ordinal", "raw_unit": "level", "direction": "higher_better", "indicator_weight_bps": 2500,
      "aggregation_method": "ordinal_from_evidence", "aggregation_config": { "predicate": "digital_investment_signals_level" },
      "normalization_method": "ordinal_rubric",
      "normalization_config": { "levels": ["low", "medium", "high"], "scores_bps": [2000, 6000, 10000] },
      "freshness_window_days": 1095, "input_predicates": ["digital_investment_signals_level"]
    },
    {
      "metric_code": "addressable_store_base", "dimension_code": "customer_value", "name": "Addressable Store Base",
      "value_type": "integer", "raw_unit": "store", "direction": "higher_better", "indicator_weight_bps": 3500,
      "aggregation_method": "addressable_store_fallback", "aggregation_config": { "input_predicates": ["addressable_store_base_actual", "qualified_store_base_actual", "retailer_store_count_actual"], "derivation_version": "retailer-foundations-v1", "fallback": "qualified_store_base_actual_or_observed_retailer_sum", "minimum_store_count": 500, "minimum_retailers": 3 },
      "normalization_method": "piecewise_linear",
      "normalization_config": { "anchors": [ { "raw": "1000", "score_bps": 0 }, { "raw": "5000", "score_bps": 3000 }, { "raw": "15000", "score_bps": 6000 }, { "raw": "30000", "score_bps": 8500 }, { "raw": "60000", "score_bps": 10000 } ] },
      "freshness_window_days": 1095, "input_predicates": ["addressable_store_base_actual", "qualified_store_base_actual", "retailer_store_count_actual"]
    },
    {
      "metric_code": "top_customer_concentration", "dimension_code": "customer_value", "name": "Top Customer Concentration",
      "value_type": "percent", "raw_unit": "percent", "direction": "higher_better", "indicator_weight_bps": 2000,
      "aggregation_method": "latest_value", "aggregation_config": { "predicate": "top_customer_concentration_percent" },
      "normalization_method": "piecewise_linear",
      "normalization_config": { "anchors": [ { "raw": "10", "score_bps": 0 }, { "raw": "30", "score_bps": 3000 }, { "raw": "50", "score_bps": 6000 }, { "raw": "70", "score_bps": 8500 }, { "raw": "90", "score_bps": 10000 } ] },
      "freshness_window_days": 1095, "input_predicates": ["top_customer_concentration_percent"]
    },
    {
      "metric_code": "estimated_acv_potential", "dimension_code": "customer_value", "name": "Estimated ACV Potential",
      "value_type": "money_usd_millions", "raw_unit": "usd_millions", "direction": "higher_better", "indicator_weight_bps": 2000,
      "aggregation_method": "estimated_acv_from_customer_base", "aggregation_config": { "input_predicates": ["estimated_acv_potential_usd_millions", "qualified_retailer_count_actual", "addressable_store_base_actual", "qualified_store_base_actual", "retailer_store_count_actual"], "derivation_version": "retailer-foundations-v1", "acv_midpoint_usd_millions": 0.15, "ideal_customer_store_count": 500, "minimum_store_count": 500, "minimum_retailers": 3 },
      "normalization_method": "piecewise_linear",
      "normalization_config": { "anchors": [ { "raw": "5", "score_bps": 0 }, { "raw": "20", "score_bps": 3000 }, { "raw": "50", "score_bps": 6000 }, { "raw": "100", "score_bps": 8500 }, { "raw": "200", "score_bps": 10000 } ] },
      "freshness_window_days": 1095, "input_predicates": ["estimated_acv_potential_usd_millions", "qualified_retailer_count_actual", "addressable_store_base_actual", "qualified_store_base_actual", "retailer_store_count_actual"]
    },
    {
      "metric_code": "use_case_need_fit", "dimension_code": "customer_value", "name": "Use Case Need Fit",
      "value_type": "ordinal", "raw_unit": "level", "direction": "higher_better", "indicator_weight_bps": 2500,
