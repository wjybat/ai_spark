      "value_type": "ordinal", "raw_unit": "level", "direction": "higher_better", "indicator_weight_bps": 2500,
      "aggregation_method": "ordinal_from_evidence", "aggregation_config": { "predicate": "new_entrant_activity_level" },
      "normalization_method": "ordinal_rubric",
      "normalization_config": { "levels": ["none", "low", "moderate", "high"], "scores_bps": [0, 3500, 7000, 10000] },
      "freshness_window_days": 548, "input_predicates": ["new_entrant_activity_level"]
    },
    {
      "metric_code": "store_system_readiness", "dimension_code": "digital", "name": "Store System Readiness",
      "value_type": "ordinal", "raw_unit": "level", "direction": "higher_better", "indicator_weight_bps": 2500,
