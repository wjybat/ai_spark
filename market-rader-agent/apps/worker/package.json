{
  "name": "@market-radar/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @market-radar/infrastructure build && NODE_USE_ENV_PROXY=1 node --import tsx --env-file-if-exists=../../.env --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@market-radar/infrastructure": "workspace:*",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7"
  }
}
