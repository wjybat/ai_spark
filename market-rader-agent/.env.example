# Process
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info
# Node 24 fetch honors HTTP(S)_PROXY when this is enabled (safe with no proxy configured).
NODE_USE_ENV_PROXY=1

# Persistent local storage
MARKET_DB_PATH=./data/market-radar.db
AGENT_DB_PATH=./data/agent-sessions.db
SOURCE_CACHE_DIR=./data/source-cache
BACKUP_DIR=./data/backups
SQLITE_BUSY_TIMEOUT_MS=5000

# Worker and leases
WORKER_ID=local-worker-1
WORKER_POLL_MS=1000
# Number of independently leased research jobs processed in parallel (1-8).
WORKER_CONCURRENCY=3
JOB_LEASE_MS=60000
JOB_HEARTBEAT_MS=15000

# Research provider: fixture (offline/replay) or pi-agent (local Pi auth + MCP search tools)
SEARCH_PROVIDER=pi-agent
SEARCH_API_KEY=
# Provider URL and Key stay in the local ~/.pi/agent/models.json and are never copied here.
PI_AGENT_MODEL=dmall-router/glm-5.3-zp
PI_AGENT_TIMEOUT_MS=300000
PI_AGENT_THINKING_LEVEL=high
AGENT_CHAT_THINKING_LEVEL=high
LLM_PROVIDER=dmall-router
LLM_MODEL_EXTRACTOR=glm-5.3-zp
LLM_MODEL_AGENT=glm-5.3-zp
LLM_MAX_TOKENS_PER_SCAN=100000
SCAN_MAX_COST_USD=25.00

# Fetch budgets
FETCH_MAX_HTML_BYTES=5242880
FETCH_MAX_PDF_BYTES=26214400
FETCH_CONNECT_TIMEOUT_MS=10000
FETCH_TOTAL_TIMEOUT_MS=30000
