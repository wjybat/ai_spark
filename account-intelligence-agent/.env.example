DATABASE_PATH=./data/app.db
FILE_STORAGE_PATH=./data/files
API_TOKEN=

# Pi 基座 Agent。默认复用 ~/.pi/agent 中的登录凭据和默认可用模型。
PI_AGENT_ENABLED=true
PI_AGENT_MODEL=
PI_AGENT_THINKING=low
PI_AGENT_TIMEOUT_MS=120000
PI_AGENT_FALLBACK=true

# Pi 不可用时的 OpenAI-compatible 兼容抽取器；均留空则使用确定性本地规则。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60000

WORKER_POLL_INTERVAL_MS=1000
MAX_UPLOAD_MB=30
