{
  "name": "global-opportunity-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "海外商机决策 Agent MVP powered by pi-agent-core",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "npm run build:markdown && tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "npm run build:markdown && tsc -p tsconfig.json",
    "build:markdown": "node scripts/build-markdown.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build:markdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx src/cli.ts --region global --customer cencosud --mode demo",
    "live": "tsx src/cli.ts --region global --customer cencosud --mode live"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@fastify/cors": "11.2.0",
    "@fastify/static": "10.1.3",
    "dotenv": "17.3.1",
    "dompurify": "3.4.14",
    "marked": "18.0.11",
    "fastify": "5.12.1"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "esbuild": "0.27.7",
    "jsdom": "27.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
